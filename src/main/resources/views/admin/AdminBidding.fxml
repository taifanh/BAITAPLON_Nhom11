<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.LineChart?>
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true"
            style="-fx-background:transparent;-fx-background-color:transparent;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bidding_system.backends.client.controllers.admin.AdminBiddingController">
    <content>
        <VBox spacing="20.0" style="-fx-padding: 16 28 34 28;">
            <children>
                <Label alignment="CENTER" maxWidth="1.7976931348623157E308"
                       text="Bidding Dashboard" textFill="#1e293b">
                    <font><Font size="28.0"/></font>
                </Label>

                <HBox minHeight="540.0" spacing="20.0">
                    <children>

                        <!-- Upcoming items list -->
                        <VBox minWidth="300.0" prefWidth="330.0" spacing="12.0"
                              style="-fx-background-color:white;-fx-background-radius:24;
                                     -fx-padding:22 24 18 24;
                                     -fx-effect:dropshadow(gaussian, rgba(15,23,42,0.08), 22, 0.12, 0, 8);">
                            <children>
                                <Label text="Upcoming Items" textFill="#0f172a">
                                    <font><Font size="20.0"/></font>
                                </Label>
                                <Label text="Items ready for bidding will appear here."
                                       textFill="#64748b"/>
                                <ListView fx:id="upcomingItems"
                                          maxHeight="1.7976931348623157E308"
                                          maxWidth="1.7976931348623157E308"
                                          prefHeight="420.0"
                                          style="-fx-background-radius:18;-fx-border-radius:18;
                                                 -fx-border-color:#dbe4f0;"
                                          VBox.vgrow="ALWAYS"/>
                            </children>
                        </VBox>

                        <!-- Auction info -->
                        <VBox alignment="TOP_CENTER" minWidth="390.0" prefWidth="430.0"
                              spacing="20.0"
                              style="-fx-background-color:white;-fx-background-radius:24;
                                     -fx-padding:22 24 22 24;
                                     -fx-effect:dropshadow(gaussian, rgba(15,23,42,0.08), 22, 0.12, 0, 8);"
                              HBox.hgrow="ALWAYS">
                            <children>
                                <Label alignment="CENTER" maxWidth="1.7976931348623157E308"
                                       minHeight="62.0"
                                       style="-fx-background-color: linear-gradient(to bottom right, #fff7ed, #ffedd5);
                                              -fx-background-radius: 16;"
                                       text="Current Auction Info" textFill="#9a3412">
                                    <font><Font size="24.0"/></font>
                                </Label>
                                <VBox spacing="8.0">
                                    <children>
                                        <Label text="Time Remaining" textFill="#64748b"/>
                                        <Label fx:id="labelTimer" alignment="CENTER"
                                               maxWidth="1.7976931348623157E308" minHeight="66.0"
                                               style="-fx-background-color:#0f172a;-fx-background-radius:15;"
                                               text="00:00:00" textFill="#fbbf24">
                                            <font><Font name="System Bold" size="36.0"/></font>
                                        </Label>
                                    </children>
                                </VBox>
                                <GridPane hgap="14.0" vgap="18.0">
                                    <children>
                                        <Label alignment="CENTER" minHeight="36.0" prefWidth="150.0"
                                               style="-fx-background-color: linear-gradient(to bottom right, #fff7ed, #ffedd5);
                                                      -fx-background-radius: 10;"
                                               text="The High Bidder" textFill="#9a3412"
                                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                        <TextField fx:id="fieldHighBidder"
                                                   maxWidth="1.7976931348623157E308" prefHeight="38.0"
                                                   style="-fx-background-radius:12;"
                                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                        <Label alignment="CENTER" minHeight="36.0" prefWidth="150.0"
                                               style="-fx-background-color: linear-gradient(to bottom right, #fff7ed, #ffedd5);
                                                      -fx-background-radius: 10;"
                                               text="Current Bid" textFill="#9a3412"
                                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                        <TextField fx:id="fieldCurrentAmount"
                                                   maxWidth="1.7976931348623157E308" prefHeight="38.0"
                                                   style="-fx-background-radius:12;"
                                                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                    </children>
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="150.0" prefWidth="150.0"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                </GridPane>
                            </children>
                        </VBox>

                        <!-- Auction control -->
                        <VBox minWidth="310.0" prefWidth="350.0" spacing="12.0">
                            <children>
                                <VBox spacing="8.0"
                                      style="-fx-background-color:white;-fx-background-radius:24;
                                             -fx-padding:18 24 18 24;
                                             -fx-effect:dropshadow(gaussian, rgba(15,23,42,0.08), 22, 0.12, 0, 8);">
                                    <children>
                                        <Label fx:id="itemName" text="Item name" textFill="#0f172a">
                                            <font><Font size="20.0"/></font>
                                        </Label>
                                        <Label text="Opening Bid" textFill="#64748b"/>
                                        <TextField fx:id="basePrice" maxWidth="1.7976931348623157E308"
                                                   prefHeight="34.0"
                                                   style="-fx-background-radius:10;-fx-border-radius:14;
                                                          -fx-border-color:#dbe4f0;-fx-background-color:white;"/>
                                        <Label text="Bid Increment" textFill="#64748b"/>
                                        <TextField fx:id="bidIncrement" maxWidth="1.7976931348623157E308"
                                                   prefHeight="34.0"
                                                   style="-fx-background-color:white;-fx-background-radius:10;
                                                          -fx-border-radius:14;-fx-border-color:#dbe4f0;"/>
                                    </children>
                                </VBox>

                                <VBox minHeight="300.0" spacing="10.0"
                                      style="-fx-background-color: linear-gradient(to bottom right, #fff7ed, #ffedd5);
                                             -fx-background-radius:24;-fx-padding:18 24 18 24;
                                             -fx-effect:dropshadow(gaussian, rgba(234,88,12,0.12), 22, 0.14, 0, 8);">
                                    <children>
                                        <Label text="Auction Control" textFill="#9a3412">
                                            <font><Font size="20.0"/></font>
                                        </Label>
                                        <Label text="Duration (minutes)" textFill="#c2410c"/>
                                        <TextField fx:id="setTime"
                                                   maxWidth="1.7976931348623157E308" prefHeight="38.0"
                                                   promptText="Set duration in minutes"
                                                   style="-fx-background-color:white;-fx-background-radius:14;
                                                          -fx-border-radius:14;-fx-border-color:#fdba74;"/>
                                        <Label fx:id="errorStartAuction" textFill="RED"/>
                                        <Button fx:id="buttonStartEndAuction"
                                                onAction="#handleStartEndAuction"
                                                prefHeight="39.0" prefWidth="183.0"
                                                style="-fx-background-color:#dc2626;-fx-background-radius:14;
                                                       -fx-text-fill:white;-fx-font-weight:bold;"
                                                text="START AUCTION"/>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                    </children>
                </HBox>
                <HBox minHeight="350.0" spacing="20.0">
                    <children>
                        <VBox spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 24; -fx-padding: 24 28 24 28; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 22, 0.12, 0, 8);" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Price Trend Monitor" textFill="#0f172a"><font><Font name="System Bold" size="22.0" /></font></Label>
                                <LineChart fx:id="priceChart"
                                           stylesheets="@../../css/style.css"
                                           animated="false"
                                           createSymbols="true"
                                           horizontalGridLinesVisible="true"
                                           legendVisible="false"
                                           title="Live Bid Price Trend"
                                           verticalGridLinesVisible="false"
                                           VBox.vgrow="ALWAYS">
                                    <xAxis><NumberAxis side="BOTTOM" tickLabelFill="#1e293b" /></xAxis>
                                    <yAxis><NumberAxis side="LEFT" tickLabelFill="#1e293b" /></yAxis>
                                </LineChart>
                            </children>
                        </VBox>

                        <VBox minWidth="380.0" prefWidth="420.0" spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 24; -fx-padding: 24 28 24 28; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 22, 0.12, 0, 8);">
                            <children>
                                <Label text="Full Bid Logs" textFill="#0f172a"><font><Font name="System Bold" size="22.0" /></font></Label>
                                <TableView fx:id="bidHistoryTable"
                                           VBox.vgrow="ALWAYS"
                                           style="-fx-background-radius: 14; -fx-border-color: #dbe4f0; -fx-border-radius: 14; -fx-background-color: white; -fx-control-inner-background: white; -fx-table-cell-border-color: #e2e8f0; -fx-text-background-color: #0f172a;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
