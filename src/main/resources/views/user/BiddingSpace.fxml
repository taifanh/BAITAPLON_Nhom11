                <Button mnemonicParsing="false" onAction="#handleHome" prefHeight="38.0" prefWidth="92.0" style="-fx-background-color: transparent; -fx-border-color: #0f172a; -fx-border-radius: 14; -fx-background-radius: 14; -fx-text-fill: #0f172a; -fx-font-weight: bold;" text="Home" />
                <Button mnemonicParsing="false" onAction="#openProfile" prefHeight="38.0" prefWidth="106.0" style="-fx-background-color: transparent; -fx-border-color: #ea580c; -fx-border-radius: 14; -fx-background-radius: 14; -fx-text-fill: #ea580c; -fx-font-weight: bold;" text="Profile" />
                <Button mnemonicParsing="false" onAction="#openBiddingSpace" prefHeight="38.0" prefWidth="132.0" style="-fx-background-color: #ea580c; -fx-background-radius: 14; -fx-text-fill: white; -fx-font-weight: bold;" text="Bidding space" />
