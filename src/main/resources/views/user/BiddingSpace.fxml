                                                <Button fx:id="buttonPlaceBid" alignment="CENTER" mnemonicParsing="false" onAction="#handlePlaceBid" prefHeight="34.0" prefWidth="116.0" style="-fx-background-color: #ea580c; -fx-background-radius: 14; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" text="PLACE" />
