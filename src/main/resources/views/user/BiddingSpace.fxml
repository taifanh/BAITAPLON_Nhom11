                                                    <font>
                                                        <Font size="17.0" />
                                                    </font>
                                                </Label>
                                                <TextField fx:id="fieldCurrentAmount" maxWidth="1.7976931348623157E308" prefHeight="38.0" style="-fx-background-radius: 12;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label alignment="CENTER" minHeight="36.0" prefWidth="150.0" style="-fx-background-color: linear-gradient(to bottom right, #fff7ed, #ffedd5); -fx-background-radius: 10;" text="Current Bid" textFill="#9a3412" GridPane.rowIndex="1">
                                       <font>
                                          <Font size="17.0" />
                                       </font>
                                    </Label>
                                    <TextField fx:id="fieldNextMinimumBid" maxWidth="1.7976931348623157E308" prefHeight="38.0" prefWidth="282.0" style="-fx-background-radius: 12;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
