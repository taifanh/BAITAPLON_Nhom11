                                                <Label text="Opening Bid" textFill="#64748b" />
                                                <TextField fx:id="fieldBasePrice" maxWidth="1.7976931348623157E308" prefHeight="34.0" style="-fx-background-radius: 10; -fx-border-radius: 14; -fx-border-color: #000000; -fx-background-color: white;" />
                                                <Label text="Current Bid Increment" textFill="#64748b" />
                                                <TextField fx:id="fieldIncrement" maxWidth="1.7976931348623157E308" prefHeight="34.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 14; -fx-border-color: #000000;" />
                                            </children>
                                        </VBox>
                                        <VBox minHeight="270.0" spacing="9.0" style="-fx-background-color: linear-gradient(to bottom right, #fff7ed, #ffedd5); -fx-background-radius: 24; -fx-padding: 18 24 18 24; -fx-effect: dropshadow(gaussian, rgba(234,88,12,0.12), 22, 0.14, 0, 8);" VBox.vgrow="ALWAYS">
